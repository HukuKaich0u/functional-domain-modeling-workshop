---
/**
 * MoonBase の線画アイコン。色は currentColor を継ぎ、装飾用なので aria-hidden にする。
 */
import { moonbaseIconPaths, type MoonbaseIconName } from "./moonbaseIcons";

interface Props {
  name: MoonbaseIconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={moonbaseIconPaths[name]}
/>
