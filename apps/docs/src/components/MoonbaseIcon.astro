---
/**
 * MoonBase の線画アイコン。色は currentColor を継ぎ、装飾用なので aria-hidden にする。
 * 線幅は隣の文字の太さに合わせる（400 なら 1.5、600 なら 2）。
 */
import { moonbaseIconPaths, type MoonbaseIconName } from "./moonbaseIcons";

interface Props {
  name: MoonbaseIconName;
  size?: number;
  strokeWidth?: 1.5 | 2;
  class?: string;
}

const { name, size = 20, strokeWidth = 1.5, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={moonbaseIconPaths[name]}
/>
