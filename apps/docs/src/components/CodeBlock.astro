---
import { Code } from "astro:components";

interface Props {
  code: string;
  language?: "shell" | "plaintext" | "typescript" | "python" | "rust";
  label?: string;
}

const { code, language = "plaintext", label } = Astro.props;
---

<figure class="code-block">
  {label === undefined ? null : <figcaption>{label}</figcaption>}
  <Code code={code} lang={language} />
</figure>
