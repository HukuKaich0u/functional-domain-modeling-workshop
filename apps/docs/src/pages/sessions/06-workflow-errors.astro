const teaching: readonly TeachingTopic[] = [
  {
    name: "Result は成功と失敗を値で表す",
    definition:
      "このプロジェクトでは neverthrow の Result を使います。Result<T, E> の T は成功値、E は呼び出し側が扱う業務上の失敗です。ok(value) は成功側の Ok、err(error) は失敗側の Err を作り、どちらも Result<T, E> として扱えます。",
    guidance: [
      "Result に含める失敗は、先に呼び出し側の対応から選びます。失敗理由に応じて呼び出し側が次の操作を選べる業務エラーを E として返します。",
      "たとえば、作業許可が見つからなければ許可番号を探し直し、まだ申請済でなければ状態を確認します。フレア警報中なら解除を待ち、線量上限を超えていれば作業員の配置を変えます。呼び出し側が理由ごとに異なる対応を選ぶ必要があるため、これらは Err で返します。",
      "一方、呼び出し側に理由別の対応がなく、要求された処理を完了できない異常はシステムエラーとして扱います。このような異常はResultに変換せず、例外として外側へ伝えます。",
      "たとえば、SQLite への保存中に接続が切れ、保存が完了したか確認できない場合です。保存が完了したか確認できないまま作業記録の追記や地上管制への通知を行うと、状態は保存されていないのに、記録や通知だけが送られる可能性があります。そのため、記録の追記や通知は実行せず、保存時の例外をそのまま外側へ伝えます。",
      "外側の例外境界では、例外をログへ記録し、必要なロールバックや接続の解放を行ったうえで、500などのエラー応答へ変換します。",
    ],
    before: {
      caption: "見つからない場合に例外を投げる guard",
      code: `const ensurePermitFound = (
  permit: EvaPermit | undefined,
  permitId: PermitId,
): EvaPermit => {
  if (permit === undefined) {
    throw new Error(\`Permit \${permitId} was not found\`);
  }

  return permit;
};`,
    },
    after: {
      caption: "neverthrow で業務上の失敗を返す guard",
      code: `import { err, ok, type Result } from "neverthrow";

const ensurePermitFound = (
  permit: EvaPermit | undefined,
  permitId: PermitId,
): Result<EvaPermit, PermitNotFound> =>
  permit === undefined
    ? err({ kind: "PermitNotFound", permitId })
    : ok(permit);`,
    },
    why: "例外では、関数の型から失敗理由を読み取れません。Result の E に業務エラーを置くと、呼び出し側は実行前から起こりうる失敗を把握し、表示や次の操作を選べます。err は例外を投げず、失敗理由を値として返します。",
  },
  {
    name: "andThen と map は成功した経路だけを進める",
    definition:
      "andThen は Ok のときだけ次の Result を返す処理へ進み、map は Ok の成功値だけを変換します。Err になった後のコールバックは呼ばれません。状態遷移は外部依存ではなくドメインの純粋関数なので、ユースケースから直接呼びます。",
    before: {
      caption: "途中で何がthrowされるか型から分からないユースケース",
      code: `import { approve } from "../domain/permit/index.js";

const approveEva =
  (deps: Dependencies) =>
  (input: ApproveEvaInput): Approved => {
    const permit = ensurePermitFound(
      deps.resolver.resolveById(input.permitId),
      input.permitId,
    );
    const requested = ensureRequested(permit);

    const clear = ensureNoFlareAlert(requested, deps.spaceWeather.currentAlert());
    if (clear.isErr()) {
      throw new Error("Approval blocked: flare alert is active");
    }
    const dose = ensureDoseWithinLimit(requested, deps.doses);
    if (dose.isErr()) {
      throw new Error(\`Approval blocked: dose limit exceeded for \${dose.error.workerId}\`);
    }

    const next = approve(requested, input, input.approvedAt);
    deps.store.save(next);
    return next;
  };`,
    },
    after: {
      caption: "Result の型と処理順を同時に読めるユースケース",
      code: `import type { Result } from "neverthrow";

import type {
  Approved,
  EvaPermit,
  PermitId,
} from "../domain/permit/index.js";
import { approve } from "../domain/permit/index.js";

type PermitNotFound = Readonly<{
  kind: "PermitNotFound";
  permitId: PermitId;
}>;

type InvalidPermitState = Readonly<{
  kind: "InvalidPermitState";
  actual: EvaPermit["kind"];
}>;

type ApproveEvaError =
  | PermitNotFound
  | InvalidPermitState
  | InsufficientOxygen
  | DoseLimitExceeded
  | FlareAlertActive
  | NightTime;

const approveEva =
  (deps: Dependencies) =>
  (input: ApproveEvaInput): Result<Approved, ApproveEvaError> =>
    ensurePermitFound(deps.resolver.resolveById(input.permitId), input.permitId)
      .andThen(ensureRequested)
      .andThen((permit) => ensureDaytime(permit, input.lunarDay))
      .andThen((permit) =>
        ensureNoFlareAlert(permit, deps.spaceWeather.currentAlert()),
      )
      .andThen((permit) => ensureOxygen(permit, input.equipmentChecks))
      .andThen((permit) => ensureDoseWithinLimit(permit, deps.doses))
      .map((permit) =>
        approve(
          permit,
          {
            segmentId: input.segmentId,
            equipmentChecks: input.equipmentChecks,
            approvedBy: input.approvedBy,
          },
          input.approvedAt,
        ),
      )
      .map((approved) => {
        deps.store.save(approved);
        return approved;
      });`,
    },
    why: "before は実行時には例外で処理が止まりますが、どの行が何をthrowするかは型に現れません。夜間、フレア警報、酸素、線量の4つの判定はすでに Result を返していますが、ユースケースが Err を例外へ変換し直しています。after は成功時に Approved のどの情報が得られるかと、6種類のどの理由で失敗するかを定義から確認できます。Err になった時点で後続の andThen と map は呼ばれません。resolver、spaceWeather、doses、store は外部境界として deps から受け取りますが、状態遷移はドメイン知識なので直接呼びます。store.save が投げる保存障害は、呼び出し側が理由別の対応を選ぶ業務エラーではなく、要求された保存処理を完了できないシステムエラーとして例外を伝播させます。",
  },
  {
    name: "match と switch で呼び出し側の処理漏れを型エラーにする",
    definition:
      "Result.match は成功時と失敗時の処理を分けます。失敗側は ApproveEvaError 全体を受け取り、error.kind の switch で各 notice へ変換します。",
    before: {
      caption: "許可なしだけを例外メッセージで処理する呼び出し側",
      code: `try {
  approveEva(dependencies)(input);
  return context.redirect("/", 303);
} catch (error) {
  if (
    error instanceof Error &&
    error.message.includes("was not found")
  ) {
    return context.redirect("/?notice=not-found", 303);
  }

  // 状態不正とフレア警報中の例外はここへ到達し、500になる。
  throw error;
}`,
    },
    after: {
      caption: "業務エラーのkindを網羅してnoticeへ変換する呼び出し側",
      code: `const assertNever = (error: never): never => {
  throw new Error(\`Unhandled error: \${JSON.stringify(error)}\`);
};

const toNoticeCode = (error: ApproveEvaError) => {
  switch (error.kind) {
    case "PermitNotFound":
      return "not-found";
    case "InvalidPermitState":
      return "invalid-state";
    case "InsufficientOxygen":
      return "oxygen";
    case "DoseLimitExceeded":
      return "dose-limit";
    case "FlareAlertActive":
      return "flare-alert";
    case "NightTime":
      return "night";
    default:
      return assertNever(error);
  }
};

return result.match(
  () => context.redirect("/", 303),
  (error) =>
    context.redirect(
      \`/?notice=\${toNoticeCode(error)}\`,
      303,
    ),
);`,
    },
    example: {
      caption: "PermitConflictを追加し、呼び出し側のcaseを足し忘れた例",
      code: `type PermitConflict = Readonly<{
  kind: "PermitConflict";
  permitId: PermitId;
}>;

type ApproveEvaError =
  | PermitNotFound
  | InvalidPermitState
  | InsufficientOxygen
  | DoseLimitExceeded
  | FlareAlertActive
  | NightTime
  | PermitConflict;

const toNoticeCode = (error: ApproveEvaError): string => {
  switch (error.kind) {
    case "PermitNotFound":
      return "not-found";
    case "InvalidPermitState":
      return "invalid-state";
    // ...酸素、線量、警報、夜間の case...
    default:
      // errorはPermitConflictなので、neverへ渡せない。
      return assertNever(error);
  }
};`,
    },
    why: "before では FlareAlertActive が追加されても catch に型エラーが出ないため、警報中の承認だけ500になりました。after は match の失敗側で union 全体を受け取り、default 節から never 専用の assertNever を呼びます。エラーの種類を追加して case を足し忘れると新しい型が default 節に残り、コンパイルエラーになります。Result に含めていないシステムエラーは、この switch では捕捉せず外側の例外境界へ伝えます。",
  },
];

const safeTryColumn = {
  title: "中間値に名前を付ける safeTry",
  introduction:
    "andThen のチェーンでは値を次の処理へ直接渡します。途中の成功値を複数使う場合や、名前を付けながら上から読みたい場合は safeTry も選べます。",
  caption: "safeTryでErrを早期returnし、Okの値を取り出す",
  code: `import { ok, safeTry, type Result } from "neverthrow";

import { approve } from "../domain/permit/index.js";

const approveEva = (
  permit: EvaPermit | undefined,
  permitId: PermitId,
  input: ApproveInput,
  approvedAt: string,
): Result<Approved, ApproveEvaError> =>
  safeTry(function* () {
    const found = yield* ensurePermitFound(permit, permitId);
    const requested = yield* ensureRequested(found);

    return ok(approve(requested, input, approvedAt));
  });`,
} as const;

const narrative = {
  requirement: "開始承認で地上管制や基地長が失敗理由に応じて操作を選ぶ失敗を型付きの値として返し、端末側が次の操作を選べるようにする。",
  currentRisk: "ユースケースは成功値だけを返す型のまま複数の Error をthrowします。端末側は許可なしの文言だけをcatchしているため、後から追加された状態不正やフレア警報中を処理できず500にしています。",
  design: "許可なしと状態不正をkindを持つDiscriminated Unionにし、配布済みの酸素、線量、警報、夜間の失敗と合わせてResultで返す。andThenで失敗後の状態遷移とStore呼び出しを止める。状態遷移はドメイン関数を直接呼び、外部境界のResolver、SpaceWeather、CrewDoseResolver、Storeだけを依存として受け取る。端末側はmatchとswitchでResultに含めた失敗を網羅してnoticeへ変換する。",
  limitation: "どの失敗を業務エラーとして画面のnoticeへ変換するかは、人の判断とレビューが必要になる。呼び出し側に理由別の対応がなく、要求された処理を完了できないシステムエラーはResultへ変換せず、外側の例外境界へ伝える。",
  legacy: "成功値しか現れない関数シグネチャ、複数箇所のthrow、例外メッセージに依存したcatchを読みます。申請済でない許可とフレア警報中の承認だけ500になる処理漏れを、演習テストで再現します。",
  fallback: "2つのguardと approveEva は解答例を反映します。最後にWebルートをmatchとswitchへ置き換え、6種類のnoticeを確認します。",
} as const;

