---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { CodeGuide } from "../../code-explorer/code-guide";
import SessionPageNavigation from "../../components/SessionPageNavigation.astro";
import type { SessionNavigation, SessionSummary } from "../../sessions/types";
import "../../styles/sessions.css";

export const finalAggregateTour = {
  label: "1業務集約 → 7業務集約",
  path: "examples/final/src/app.ts",
  aggregates: [
    "作業許可",
    "系統区間",
    "隊員",
    "装備点検",
    "宇宙天気",
    "セッション",
    "ユーザー",
  ],
};

export const guides = ([
  {
    id: "final-use-case-pipeline",
    title: "最初に読む ResultAsync パイプライン",
    currentDesign:
      "Session 07 で学んだ形を、認可、7条件の確認、永続化を含む開始承認の use case へ広げています。",
    futureRisk: "全体から読むと概念が多いため、まず run の処理だけを追います。",
    path: "src/useCase/approveEvaUseCase.ts",
    highlights: [{ startLineNumber: 198, endLineNumber: 243 }],
  },
  {
    id: "final-seven-aggregates",
    title: "1業務集約から7つの集約へ広がる配線",
    currentDesign: `${finalAggregateTour.aggregates.join("・")}の7つの集約を composition root で配線しています。`,
    futureRisk:
      "個別ファイルから読み始めると集約どうしの接続が見えないため、composition root から辿ります。",
    path: finalAggregateTour.path.replace("examples/final/", ""),
    highlights: [{ startLineNumber: 235, endLineNumber: 250 }],
  },
  {
    id: "final-transaction-store",
    title: "in-memory から SQLite transaction へ広がる",
    currentDesign: "遮断札の取り外しと作業許可の完了という2つの集約の更新を、1つの transaction で保存します。",
    futureRisk: "単純な dual-write へ戻すと、遮断盤の状態と作業記録が分離します（事故報告 第1号）。",
    path: "src/adaptor/secondary/sqlite/store/lockoutReleaseStore.ts",
    highlights: [{ startLineNumber: 46, endLineNumber: 75 }],
  },
] as const) satisfies readonly CodeGuide[];

export const session: SessionSummary = {
  slug: "final",
  snapshot: "final",
  sequence: "Final",
  kind: "reference",
  title: "参照実装で境界をたどる",
  durationMinutes: 5,
  timeBreakdown: { brief: 0, teach: 4, exercise: 0, review: 1 },
  scene: { place: "作業状況ボードの前", role: "開発者", avatar: "🌙" },
  summary: "ここまでの学習内容を、より大きな参照実装へ接続します。",
  episode: [
    "ここまで直した頃、隊員たちはとっくにエアロックの内側に戻り、開発者だけが参照実装の前に残っていました。",
    "入力、失敗、イベント、保存、例外を順に追うと、さっきまでの事故がそれぞれ決まった場所で待っています。",
    "完成形と呼んでも、事故が消えたわけではありません。置き場所と担当が決まっただけです。",
  ],
  incident: "各セッションで行った改善を、実運用を想定した構成へどう接続するかを確認する。",
  steps: [],
  decisions: [],
  finalReferences: [
    "examples/final/src/useCase/approveEvaUseCase.ts",
    finalAggregateTour.path,
  ],
};

const chapters = [
  { id: "incident", label: "5つの境界を確認する" },
  { id: "review", label: "レビューと持ち帰り" },
] as const;
export const navigation = ({
  previous: {
    href: "/sessions/07-effects-and-consistency/",
    title: "副作用と整合性境界を設計する",
  },
  next: undefined,
} as SessionNavigation);
---

<BaseLayout title={`${session.title} | FP with TypeScript`} description={session.summary}>
  <div class="case-file case-file--session">
    <header class="case-file__site-header">
      <a href="/"><span class="case-file__brand-mark" aria-hidden="true">🌙</span>MoonBase 日の出基地</a>
    </header>
    <main>
      <SessionPageNavigation currentSlug={session.slug} chapters={chapters}>
      <section slot="hero" class="case-file__hero" aria-labelledby="session-title">
        <p class="case-file__eyebrow">SESSION {session.sequence} · {session.durationMinutes}分</p>
        <h1 id="session-title">{session.title}</h1>
        <p class="case-file__summary">
          <span aria-hidden="true">{session.scene.avatar}</span>
          {session.summary}
        </p>
        <p class="case-file__scene">
          <span class="case-file__scene-label">場面</span>
          {session.scene.place} · {session.scene.role}
        </p>
      </section>
  <section id="incident">
    <h2>何が起きたか</h2>
    <aside class="case-file__episode" aria-label="日の出基地のひと幕">
      <p class="case-file__episode-label">日の出基地のひと幕</p>
      {session.episode.map((line) => <p data-episode-line>{line}</p>)}
    </aside>
    <p>
      S3〜S7 の到達点 <code>examples/session-08</code> では、開始承認の入力、業務上の失敗、出力イベント、保存、例外経路を分けました。ここでは、この5つの境界が、系統区間や隊員、宇宙天気まで含む参照実装でも保たれているかを確認します。
    </p>
    <p><strong>今回の完了条件:</strong> 技術要素の数ではなく、ユースケースを構成する5つの境界を説明できることです。</p>
  </section>

  <section id="review">
    <h2>5つの境界を確認する</h2>
    <p>ひとりの場合は、次のファイルを順に開いて該当箇所を探します。ハンズオンでは進行役が5分を目安に案内します。参照実装の起動やDBの操作は必要ありません。</p>
    <ol class="decision-list">
      <li>
        <strong>入力境界</strong><br />
        <code>examples/final/src/adaptor/primary/web/routes/permitRoutes.ts</code> で、URL の作業許可番号を <code>PermitId</code> として検証し、ユースケース入力へ変換する箇所を探します。宇宙天気の外部 JSON は <code>spaceWeatherRoutes.ts</code> の zod schema が境界です。
      </li>
      <li>
        <strong>業務上の失敗</strong><br />
        <code>examples/final/src/useCase/approveEvaUseCase.ts</code> で、許可なし・状態不正・7条件の不成立・保存競合が型付きの <code>Err</code> として残ることを確認します。被ばく量の判定は値を返さず、<code>ExposureLimitExceeded</code> という事実だけを返します。
      </li>
      <li>
        <strong>出力イベント</strong><br />
        <code>examples/final/src/useCase/approveEvaUseCase.ts</code> で、7条件を通った経路だけがイベント生成へ進むことを確認します。次に、<code>examples/final/src/domain/permit/permit.ts</code> の <code>approve</code> が、承認者、地球時、月面日を実行コンテキストから取って <code>EvaApproved</code> を作ることを確認します。
      </li>
      <li>
        <strong>副作用</strong><br />
        <code>examples/final/src/adaptor/secondary/sqlite/store/permitEventStore.ts</code> で、作業許可の状態と作業記録を同じ保存境界へ渡すことを確認します。<code>lockoutReleaseStore.ts</code> では、遮断札の取り外しと完了という2つの集約が1つの transaction に入ります。
      </li>
      <li>
        <strong>例外境界</strong><br />
        SQLite障害や破損データが業務 <code>Result</code> に入らず、<code>examples/final/src/app.ts</code> の共通境界で安全に記録され、詳細を含まない500応答になることを確認します。被ばく量が混入した作業記録は、読み出し側の <code>persistedEventRow.ts</code> が伏せて見せるのではなく拒みます。
      </li>
    </ol>
    <p>
      自習では、遮断札を掛ける、緊急帰還を記録する、宇宙天気を報告するなど、別のきっかけから始まるユースケースを1つ選び、同じ5項目を辿ってください。境界が見つからない箇所は、次に試す小さな改善候補です。
    </p>
  </section>
      <nav slot="footer" class="case-file__session-nav" aria-label="前後のセッション">
        {
          navigation.previous === undefined ? null : (
            <a rel="prev" href={navigation.previous.href}>前へ: {navigation.previous.title}</a>
          )
        }
        {
          navigation.next === undefined ? null : (
            <a rel="next" href={navigation.next.href}>次へ: {navigation.next.title}</a>
          )
        }
      </nav>
      </SessionPageNavigation>
    </main>
  </div>
</BaseLayout>
