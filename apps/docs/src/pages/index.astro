---
import BaseLayout from "../layouts/BaseLayout.astro";
import MoonbaseIcon from "../components/MoonbaseIcon.astro";
import { crew, crewPhotoPath } from "../sessions/crew";
import "../styles/moonbase-home.css";


type Condition = Readonly<{
  label: string;
  value: string;
  state: "pending" | "ok" | "masked";
}>;

const conditions: readonly Condition[] = [
  { label: "装備点検", value: "2名分 未実施", state: "pending" },
  { label: "酸素残時間", value: "未記録", state: "pending" },
  { label: "被ばく量", value: "作業後も上限以内", state: "masked" },
  { label: "宇宙天気", value: "フレア警報なし", state: "ok" },
  { label: "遮断札", value: "PV-07 に EVA-0412 の札", state: "ok" },
  { label: "相方", value: "作業員a · 作業員b", state: "ok" },
  { label: "月面日", value: "第1日 · 日照中", state: "ok" },
];

type Reading = Readonly<{ label: string; value: string; note?: string }>;

const readings: readonly Reading[] = [
  { label: "月面日", value: "第1日", note: "昼 · 日照14日" },
  { label: "日没まで", value: "14日", note: "第15日から夜" },
  { label: "系統接続", value: "PV-06", note: "次は PV-07〜09" },
  { label: "蓄電池", value: "14日分", note: "生命維持ぎりぎり" },
  { label: "地球との通信", value: "1.3秒", note: "片道" },
  { label: "滞在", value: "11名", note: "本社運用室 1〜2名" },
];

type Stop = Readonly<{
  code: string;
  phase: string;
  title: string;
  description: string;
  href: string;
}>;

const stops: readonly Stop[] = [
  { code: "S0", phase: "着任", title: "月面基地へ着任する", description: "基地の規程、役割、未完成システム、作業許可 EVA-0412 を確認する。", href: "/sessions/00-system-handover/" },
  { code: "S1", phase: "比較", title: "実装の違いを読む", description: "同じ安全規程を表す実装を比べ、型と実行時検証の境界を話し合う。", href: "/sessions/01-design-approaches/" },
  { code: "S2", phase: "業務", title: "船外作業の中止を設計する", description: "「船外作業が中止された」からアクター、コマンド、業務条件を逆算する。", href: "/sessions/02-business-events-and-workflows/" },
  { code: "S3", phase: "状態", title: "許可されない状態遷移", description: "作業許可の状態ごとに可能な操作を型で限定する。", href: "/sessions/03-state-transitions/" },
  { code: "S4", phase: "識別子", title: "識別子の取り違え", description: "許可ID、隊員ID、系統区間IDを異なる型として扱う。", href: "/sessions/04-semantic-identifiers/" },
  { code: "S5", phase: "境界", title: "未検証の外部入力", description: "HTTP入力を境界で検証し、承認に必要な型付き入力へ変換する。", href: "/sessions/05-boundaries-and-sensitive-data/" },
  { code: "S6", phase: "失敗", title: "予期できる業務エラー", description: "許可なしや状態不正を、呼び出し側が扱える Result へ変える。", href: "/sessions/06-workflow-errors/" },
  { code: "S7", phase: "副作用", title: "イベントと副作用", description: "時刻とIDを外から渡し、状態と監査記録を同じ境界で保存する。", href: "/sessions/07-effects-and-consistency/" },
];

const stateLabel: Record<Condition["state"], string> = {
  pending: "未確認",
  ok: "確認",
  masked: "医務のみ",
};
---

<BaseLayout
  title="MoonBase 日の出基地 — TypeScriptで学ぶ関数型ドメインモデリング"
  description="月面基地の船外作業許可を題材に、安全規程を型と関数で表す関数型ドメインモデリング教材。"
  bodyClass="landing-body"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      crossorigin="anonymous"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@500;700&family=Zen+Kaku+Gothic+New:wght@500;700&display=swap"
    />
  </Fragment>

  <canvas id="starfield" class="starfield" aria-hidden="true"></canvas>
  <div class="grain" aria-hidden="true"></div>

  <div class="landing">
    <header class="landing__header" aria-label="サイトヘッダー">
      <a class="landing__brand" href="/">
        <span class="landing__brand-mark" aria-hidden="true"></span>
        <span class="landing__brand-name">MoonBase</span>
        <span class="landing__brand-base">日の出基地</span>
      </a>
      <p class="landing__doc" aria-label="文書番号">MB-DOC 0412 · 月面日 第1日</p>
      <nav class="landing__nav" aria-label="メインナビゲーション">
        <a href="#crew">乗員</a>
        <a href="#curriculum">セッション</a>
        <a href="/setup/">事前準備</a>
        <a class="landing__nav-start" href="/sessions/">セッション一覧</a>
      </nav>
    </header>

    <main class="landing__main">
      <section class="hero" aria-labelledby="page-title">
        <figure class="hero__photo">
          <img
            src={crewPhotoPath("eva-worker-b")}
            alt="地球が昇る空の下、宇宙服で基地の前に立つ船外作業員"
            width="1124"
            height="1408"
            fetchpriority="high"
          />
          <figcaption>赤道発電所 PV-07 区画 · 船外作業員 b · 月面日 第1日</figcaption>
        </figure>

        <div class="hero__copy">
          <p class="hero__eyebrow" data-reveal style="--i: 0">
            <span>TypeScript で学ぶ関数型ドメインモデリング</span>
          </p>
          <h1 id="page-title" data-reveal style="--i: 1">日没まで、<br />あと十四日。</h1>
          <p class="hero__lead" data-reveal style="--i: 2">
            月面基地 MoonBase の船外作業許可を題材に、安全規程を型と関数で表す教材です。
            補給便で着任したシステム担当として、前任者が残した未完成のコードを読み、
            7つの開始条件と監査記録を段階的に実装していきます。
          </p>
          <div class="hero__actions" data-reveal style="--i: 3">
            <a class="button button--primary" href="/setup/">
              事前準備をする
              <MoonbaseIcon name="arrow" size={16} strokeWidth={2} />
            </a>
            <a class="button button--ghost" href="/sessions/">セッション一覧を見る</a>
          </div>
        </div>
      </section>

      <section class="readout" aria-label="日の出基地の現況">
        <dl class="readout__grid">
          {readings.map((reading) => (
            <div class="readout__cell">
              <dt>{reading.label}</dt>
              <dd>
                <span class="readout__value">{reading.value}</span>
                {reading.note && <span class="readout__note">{reading.note}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="dossier" id="dossier" aria-labelledby="dossier-title">
        <div class="dossier__copy">
          <p class="section-head__eyebrow">引き継ぎ</p>
          <h2 id="dossier-title" class="section-head__title">前任者が机に残した、<br />承認待ちの作業許可書</h2>
          <p class="section-head__lead">
            着任初日、前任者は帰りの支度をしながら事故報告 第1号のプリントと、この作業許可書を手渡してきました。
            装備点検と酸素残時間が未確認のまま、基地長の承認を待っています。
          </p>
          <p class="section-head__lead">
            月面では宇宙服でも放射線を完全には防げません。医務が管理する「被ばく量」は承認の判定に使いますが、
            作業記録には残しません。そうした規程を、教材ではコードの制約として書き直します。
          </p>
          <ul class="dossier__rules">
            <li><MoonbaseIcon name="tag" size={18} /> 遮断して札を掛けた系統区間でしか作業しない</li>
            <li><MoonbaseIcon name="suit" size={18} /> 船外は2名1組。相方の装備を互いに点検する</li>
            <li><MoonbaseIcon name="log" size={18} /> 申請・承認・出発・帰還・中止をすべて作業記録に追記する</li>
          </ul>
        </div>

        <article class="permit" aria-label="作業許可書 EVA-0412">
          <span class="permit__stamp" aria-hidden="true">未承認</span>
          <header class="permit__head">
            <p class="permit__org">MoonBase 日の出基地 · 船外作業許可書</p>
            <p class="permit__form">書式 EVA-01</p>
            <p class="permit__id">EVA-0412</p>
          </header>

          <dl class="permit__meta">
            <div><dt>作業区画</dt><dd>PV-07 太陽電池アレイ点検</dd></div>
            <div><dt>予定</dt><dd>第1日 06:40 UTC · 90分</dd></div>
            <div><dt>隊員</dt><dd>作業員 a · 作業員 b</dd></div>
            <div><dt>申請</dt><dd>地上管制</dd></div>
          </dl>

          <ol class="permit__track" aria-label="作業許可の状態">
            <li class="is-current">申請済み</li>
            <li>承認済み</li>
            <li>船外</li>
            <li>帰還済み</li>
          </ol>

          <h3 class="permit__section">開始条件</h3>
          <ul class="permit__conditions">
            {conditions.map((condition) => (
              <li class={`permit__condition is-${condition.state}`}>
                <span class="permit__check" aria-hidden="true"></span>
                <span class="permit__condition-label">{condition.label}</span>
                <span class="permit__condition-value">{condition.value}</span>
                <span class="permit__condition-state">{stateLabel[condition.state]}</span>
              </li>
            ))}
          </ul>

          <footer class="permit__foot">
            <p>基地長承認欄</p>
            <p class="permit__sign">7条件が一つでも欠ければ承認できない</p>
          </footer>
        </article>
      </section>

      <section class="crew" id="crew" aria-labelledby="crew-title">
        <div class="section-head">
          <p class="section-head__eyebrow">乗員名簿</p>
          <h2 id="crew-title" class="section-head__title">日の出基地に滞在する11名と、1台</h2>
          <p class="section-head__lead">
            人は役割名で呼び、個人名を出しません。それぞれの責務が、そのまま作業許可の開始条件になります。
          </p>
        </div>
        <ol class="crew__grid">
          {crew.map((member, index) => (
            <li class="crew__member" data-reveal style={`--i: ${index}`}>
              <figure>
                <div class="crew__photo">
                  <img src={crewPhotoPath(member.id)} alt={member.alt} width="1122" height="1402" loading="lazy" decoding="async" />
                </div>
                <figcaption>
                  <span class="crew__no">No. {member.no}</span>
                  <span class="crew__role">{member.role}</span>
                  <span class="crew__duty">{member.duty}</span>
                  <span class="crew__system">{member.system}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ol>
      </section>

      <section class="curriculum" id="curriculum" aria-labelledby="curriculum-title">
        <div class="section-head">
          <p class="section-head__eyebrow">セッション</p>
          <h2 id="curriculum-title" class="section-head__title">引き継いだコードには、安全規程がない</h2>
          <p class="section-head__lead">
            文字列だけの状態や識別子、未検証の入力、例外に埋もれた業務上の失敗を順に見直し、
            船外作業を開始できる条件をコードで閉じます。
          </p>
        </div>
        <ol class="curriculum__list">
          {stops.map((stop, index) => (
            <li class="curriculum__stop" data-reveal style={`--i: ${index}`}>
              <a href={stop.href}>
                <span class="curriculum__code">{stop.code}</span>
                <span class="curriculum__body">
                  <span class="curriculum__phase">{stop.phase}</span>
                  <span class="curriculum__title">{stop.title}</span>
                  <span class="curriculum__description">{stop.description}</span>
                </span>
                <MoonbaseIcon name="arrow" size={18} class="curriculum__arrow" />
              </a>
            </li>
          ))}
        </ol>
        <div class="curriculum__final">
          <p>すべてのセッションを終えると、7つの集約からなる日の出基地の参照実装にたどり着きます。</p>
          <a class="button button--ghost" href="/sessions/final/">Final の参照実装を見る</a>
        </div>
      </section>
    </main>

    <footer class="landing__footer">
      <p>MoonBase の物語に沿って、Session 00 から順に安全規程をコードへ移していきます。</p>
      <a class="button button--primary" href="/sessions/">
        セッション一覧を開く
        <MoonbaseIcon name="arrow" size={16} strokeWidth={2} />
      </a>
      <p class="landing__footer-note">
        MoonBase と日の出基地は教材のための架空の企業と施設です。実在の宇宙機関、計画、企業とは関係ありません。
      </p>
    </footer>
  </div>

  <script>
    // 星空。ハッブルのディープフィールドのように、暗い空に無数の淡い光を散らす。
    // 遠い層ほど小さく数が多く、色は青白から琥珀、ごく一部が赤味を帯びる。
    // 星のほかに、傾いた楕円の淡い銀河と、回折の十字を持つ明るい星を少数だけ描く。
    // スクロールに追従して奥行きごとに違う速さで流れ、星だけがゆっくり瞬く。
    // reduced-motion では静止した空を描く。
    const canvas = document.querySelector<HTMLCanvasElement>("#starfield");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (canvas) {
      const context = canvas.getContext("2d");
      if (context) {
        type Star = { x: number; y: number; r: number; alpha: number; depth: number; phase: number; color: string };
        type Galaxy = {
          x: number; y: number; rx: number; ry: number; rotation: number; alpha: number; depth: number; color: string;
          gradient: CanvasGradient | null;
        };
        type BrightStar = { x: number; y: number; r: number; spike: number; alpha: number; depth: number; phase: number; color: string };

        // 手前ほど青白く、遠いほど暖色が混じる（赤方偏移の気分）
        const cool = ["#e4e8f2", "#d9e2ff", "#eef0f5"];
        const warm = ["#efd9a0", "#e9c38a", "#e2a96b"];
        const red = ["#d98d6c", "#c9755e"];
        const pick = (list: readonly string[]) => list[Math.floor(Math.random() * list.length)] ?? list[0]!;
        const starColor = (warmRate: number, redRate: number) => {
          const t = Math.random();
          if (t < redRate) return pick(red);
          if (t < redRate + warmRate) return pick(warm);
          return pick(cool);
        };

        const layers = [
          { count: 820, depth: 0.1, radius: [0.3, 0.75] as const, alpha: [0.22, 0.6] as const, warm: 0.3, red: 0.08 },
          { count: 260, depth: 0.26, radius: [0.7, 1.15] as const, alpha: [0.38, 0.8] as const, warm: 0.24, red: 0.04 },
          { count: 52, depth: 0.5, radius: [1.1, 1.65] as const, alpha: [0.55, 0.9] as const, warm: 0.18, red: 0 },
        ];
        const galaxyCount = 72;
        const brightCount = 7;

        let width = 0;
        let height = 0;
        let stars: Star[] = [];
        let galaxies: Galaxy[] = [];
        let brights: BrightStar[] = [];
        let scrollY = window.scrollY;
        let frame = 0;

        const between = (range: readonly [number, number]) => range[0] + Math.random() * (range[1] - range[0]);

        const seed = () => {
          stars = [];
          galaxies = [];
          brights = [];
          const scale = Math.max(0.5, (width * height) / (1280 * 800));
          const span = height * 1.6;
          for (const layer of layers) {
            const count = Math.round(layer.count * scale);
            for (let i = 0; i < count; i += 1) {
              stars.push({
                x: Math.random() * width,
                y: Math.random() * span,
                r: between(layer.radius),
                alpha: between(layer.alpha),
                depth: layer.depth,
                phase: Math.random() * Math.PI * 2,
                color: starColor(layer.warm, layer.red),
              });
            }
          }
          for (let i = 0; i < Math.round(galaxyCount * scale); i += 1) {
            const rx = 1.4 + Math.random() * 3.2;
            galaxies.push({
              x: Math.random() * width,
              y: Math.random() * span,
              rx,
              ry: rx * (0.32 + Math.random() * 0.6),
              rotation: Math.random() * Math.PI,
              alpha: 0.3 + Math.random() * 0.35,
              depth: 0.18,
              color: Math.random() < 0.55 ? pick(warm) : pick(cool),
              gradient: null,
            });
          }
          for (let i = 0; i < brightCount; i += 1) {
            brights.push({
              x: Math.random() * width,
              y: Math.random() * span,
              r: 1.4 + Math.random() * 0.8,
              spike: 7 + Math.random() * 9,
              alpha: 0.7 + Math.random() * 0.25,
              depth: 0.42,
              phase: Math.random() * Math.PI * 2,
              color: Math.random() < 0.4 ? "#efd9a0" : "#e9eef8",
            });
          }
        };

        const resize = () => {
          const ratio = Math.min(window.devicePixelRatio || 1, 2);
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = Math.round(width * ratio);
          canvas.height = Math.round(height * ratio);
          context.setTransform(ratio, 0, 0, ratio, 0, 0);
          seed();
        };

        const wrap = (y: number, depth: number, span: number) =>
          ((((y - scrollY * depth) % span) + span) % span) - height * 0.3;

        const draw = (now: number) => {
          frame = 0;
          context.clearRect(0, 0, width, height);
          const span = height * 1.6;

          // 銀河。瞬かない。中心から外へ薄れる楕円
          for (const galaxy of galaxies) {
            const y = wrap(galaxy.y, galaxy.depth, span);
            if (y < -8 || y > height + 8) continue;
            if (!galaxy.gradient) {
              const gradient = context.createRadialGradient(0, 0, 0, 0, 0, galaxy.rx);
              gradient.addColorStop(0, galaxy.color);
              gradient.addColorStop(0.45, galaxy.color);
              gradient.addColorStop(1, "rgb(0 0 0 / 0)");
              galaxy.gradient = gradient;
            }
            context.save();
            context.translate(galaxy.x, y);
            context.rotate(galaxy.rotation);
            context.scale(1, galaxy.ry / galaxy.rx);
            context.globalAlpha = galaxy.alpha;
            context.fillStyle = galaxy.gradient;
            context.beginPath();
            context.arc(0, 0, galaxy.rx, 0, Math.PI * 2);
            context.fill();
            context.restore();
          }

          // 星
          for (const star of stars) {
            const y = wrap(star.y, star.depth, span);
            if (y < -2 || y > height + 2) continue;
            const twinkle = reduceMotion ? 1 : 0.72 + 0.28 * Math.sin(now / 1700 + star.phase);
            context.globalAlpha = star.alpha * twinkle;
            context.fillStyle = star.color;
            context.beginPath();
            context.arc(star.x, y, star.r, 0, Math.PI * 2);
            context.fill();
          }

          // 明るい星。淡い滲みと、望遠鏡の回折による細い十字
          for (const bright of brights) {
            const y = wrap(bright.y, bright.depth, span);
            if (y < -20 || y > height + 20) continue;
            const twinkle = reduceMotion ? 1 : 0.85 + 0.15 * Math.sin(now / 2300 + bright.phase);
            context.globalAlpha = bright.alpha * 0.16 * twinkle;
            context.fillStyle = bright.color;
            context.beginPath();
            context.arc(bright.x, y, bright.r * 3.2, 0, Math.PI * 2);
            context.fill();
            context.globalAlpha = bright.alpha * 0.55 * twinkle;
            context.strokeStyle = bright.color;
            context.lineWidth = 0.7;
            context.beginPath();
            context.moveTo(bright.x - bright.spike, y);
            context.lineTo(bright.x + bright.spike, y);
            context.moveTo(bright.x, y - bright.spike);
            context.lineTo(bright.x, y + bright.spike);
            context.stroke();
            context.globalAlpha = bright.alpha * twinkle;
            context.beginPath();
            context.arc(bright.x, y, bright.r, 0, Math.PI * 2);
            context.fill();
          }

          context.globalAlpha = 1;
          if (!reduceMotion && !document.hidden) {
            frame = window.requestAnimationFrame(draw);
          }
        };

        const request = () => {
          if (frame === 0) frame = window.requestAnimationFrame(draw);
        };

        resize();
        request();
        window.addEventListener("resize", () => { resize(); request(); }, { passive: true });
        window.addEventListener("scroll", () => { scrollY = window.scrollY; if (reduceMotion) request(); }, { passive: true });
        document.addEventListener("visibilitychange", () => { if (!document.hidden) request(); });
      }
    }

    // 初回だけの段階的な登場。見えた要素に is-visible を付け、以後は触らない。
    document.documentElement.classList.add("js");
    const revealTargets = document.querySelectorAll<HTMLElement>("[data-reveal]");
    if (reduceMotion || !("IntersectionObserver" in window)) {
      for (const target of revealTargets) target.classList.add("is-visible");
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.1 },
      );
      for (const target of revealTargets) observer.observe(target);
    }
  </script>
</BaseLayout>
