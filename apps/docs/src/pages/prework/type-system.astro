import boundary from "../../prework/examples/boundary.ts?raw";
import operators from "../../prework/examples/type-operators.ts?raw";
const chapters = [
  { id: "roles", label: "型システム・型駆動・型レベルの違い" },
  { id: "structure", label: "型の名前と値の構造" },
  { id: "states", label: "積と和で状態を表す" },
  { id: "boundary", label: "unknownから検証済みの値へ" },
  { id: "operators", label: "型から別の型を作る" },
  { id: "exercise", label: "状態を増やして確かめる" },
