---
import BaseLayout from "./BaseLayout.astro";
import SkyHeader from "../components/SkyHeader.astro";
import EarthriseFooter from "../components/EarthriseFooter.astro";
import SessionPageNavigation from "../components/SessionPageNavigation.astro";
import { preworkCurriculum } from "../prework/navigation";
import "../styles/sessions.css";

interface Props {
  title: string;
  description: string;
  duration?: string;
  chapters: readonly { id: string; label: string }[];
}
const { title, description, duration, chapters } = Astro.props;
const current = preworkCurriculum.items.find(({ href }) => href === Astro.url.pathname);
if (current === undefined) throw new Error(`Unknown prework page: ${Astro.url.pathname}`);
---

<BaseLayout title={`${title} | FP with TypeScript`} description={description}>
  <div class="case-file case-file--session">
    <SkyHeader label={`MB-DOC 0412 · Prework ${current.sequence}`} />
    <main>
      <SessionPageNavigation currentSlug={current.slug} chapters={chapters} curriculum={preworkCurriculum}>
        <section slot="hero" class="case-file__hero" aria-labelledby="prework-title">
          <p class="case-file__eyebrow">PREWORK {current.sequence} · 任意の事前学習{duration && ` · ${duration}`}</p>
          <h1 id="prework-title">{title}</h1>
          <p class="case-file__summary"><span aria-hidden="true"></span>{description}</p>
          <p class="case-file__scene"><a href="/sessions/">本編のセッション一覧</a> · <a href="/setup/">事前準備</a></p>
        </section>
        <slot />
        <nav slot="footer" class="case-file__session-nav" aria-label="次の学習"><slot name="next" /></nav>
      </SessionPageNavigation>
    </main>
    <EarthriseFooter />
  </div>
</BaseLayout>
