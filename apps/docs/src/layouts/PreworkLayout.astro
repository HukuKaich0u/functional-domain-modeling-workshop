---
import BaseLayout from "./BaseLayout.astro";
import "../styles/sessions.css";

interface Props {
  title: string;
  description: string;
  duration?: string;
  chapters: readonly { id: string; label: string }[];
}
const { title, description, duration, chapters } = Astro.props;
---

<BaseLayout title={`${title} | 事前学習 | FP with TypeScript`} description={description}>
  <div class="case-file prework">
    <header class="case-file__site-header">
      <a href="/"><span class="case-file__brand-mark" aria-hidden="true"></span><span>MoonBase 日の出基地</span></a>
    </header>
    <main class="prework__main">
      <nav aria-label="パンくず"><a href="/sessions/">セッション一覧</a> / <a href="/prework/">事前学習</a></nav>
      <header class="prework__hero">
        <p class="case-file__eyebrow">PREWORK · 任意の事前学習{duration && ` · ${duration}`}</p>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>
      <nav class="prework__toc" aria-label="このページの目次">
        <strong>このページで学ぶこと</strong>
        <ol>{chapters.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
      </nav>
      <article class="case-file__content"><slot /></article>
      <nav class="prework__next" aria-label="次の学習"><slot name="next" /></nav>
    </main>
  </div>
</BaseLayout>

<style>
  .prework__main { width: min(100% - 2rem, 58rem); margin-inline: auto; padding-block: 2rem 4rem; }
  .prework__hero { margin-block: 2.5rem; }
  h1 { font-size: clamp(2rem, 6vw, 3.5rem); line-height: 1.3; margin-block: 0 1rem; }
  .prework__hero > p:last-child { line-height: 1.9; }
  .prework__toc { border: 1px solid var(--case-line); padding: 1.25rem; margin-bottom: 2rem; background: var(--case-paper); }
  .prework__toc ol { margin-bottom: 0; padding-left: 1.5rem; line-height: 1.9; }
  .prework .case-file__content { display: block; min-width: 0; padding: clamp(1rem, 4vw, 2.5rem); }
  .prework :global(section) { margin-bottom: 3rem; scroll-margin-top: 1rem; }
  .prework :global(h2) { line-height: 1.4; }
  .prework :global(h3) { margin-top: 2rem; }
  .prework :global(p), .prework :global(li) { line-height: 1.9; overflow-wrap: anywhere; }
  .prework :global(.code-block) { min-width: 0; margin-inline: 0; }
  .prework :global(pre) { max-width: 100%; overflow-x: auto; }
  .prework :global(summary) { cursor: pointer; font-weight: 700; }
  .prework :global(details) { padding: 1rem; border: 1px solid var(--case-line); }
  .prework__next { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 2rem; line-height: 1.8; }
</style>
